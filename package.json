{
  "name": "full-text-rss-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted proxy that turns partial/paywalled RSS feeds into full-text feeds using your own authenticated subscription session.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r src/views dist/views && cp -r src/public dist/public",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/http-proxy": "^11.5.0",
    "@fastify/static": "^9.1.1",
    "@mozilla/readability": "^0.6.0",
    "@simplewebauthn/server": "^13.3.2",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.45.2",
    "eta": "^3.5.0",
    "fastify": "^5.2.1",
    "feed": "^4.2.2",
    "jsdom": "^25.0.1",
    "nanoid": "^5.0.9",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "playwright": "1.61.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.14.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/sanitize-html": "^2.13.0",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11"
  }
}
