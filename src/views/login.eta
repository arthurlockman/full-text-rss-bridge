<%~ include('/partials/header', { title: 'Log in', nav: false, csrf: it.csrf }) %>
<div class="card narrow">
  <h1>Log in</h1>
  <p class="muted">Authenticate with your passkey.</p>
  <p class="error" id="passkey-error" hidden></p>
  <button type="button" class="btn primary" id="passkey-login"
          data-endpoint-options="/login/options" data-endpoint-verify="/login/verify">
    Log in with passkey
  </button>
  <p class="muted small" id="passkey-unsupported" hidden>
    This browser doesn't support passkeys. Use a modern browser over HTTPS
    (or http://localhost).
  </p>
</div>
<script src="/public/vendor/simplewebauthn-browser.umd.min.js"></script>
<script src="/public/js/passkeys.js" defer></script>
<%~ include('/partials/footer') %>
