# --- Server ---
# Port the web UI + feed endpoints listen on.
PORT=8080
# Bind address. Use 0.0.0.0 in a container.
HOST=0.0.0.0
# Public base URL used when generating feed links (no trailing slash).
# Also controls cookie security: set an https:// URL when deploying behind
# TLS so session/CSRF cookies are marked Secure. Use http:// for direct
# LAN/localhost access so login works without HTTPS.
PUBLIC_BASE_URL=http://localhost:8080
# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
NODE_ENV=development

# --- Data ---
# Directory holding the SQLite DB, session state, and caches.
DATA_DIR=./data

# --- Security ---
# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: key used to encrypt stored site sessions at rest (openssl rand -hex 32).
# Leave empty to store session state unencrypted.
SESSION_ENCRYPTION_KEY=

# --- Browser / capture ---
# X display used by the headed Chromium during interactive capture.
DISPLAY=:99
# VNC port that x11vnc listens on (localhost only).
VNC_PORT=5900
# Port that websockify/noVNC listens on inside the container (localhost only;
# the app reverse-proxies it same-origin under /novnc).
NOVNC_PORT=6080
# noVNC client URL embedded in the capture page. In Docker this is served
# same-origin by the app, so the default subpath works and no extra port needs
# publishing. Leave empty for local dev (a native Chromium window opens instead).
NOVNC_URL=/novnc/vnc.html
